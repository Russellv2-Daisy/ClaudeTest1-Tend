# Local-only dev server — must NOT be deployed/built by Vercel.
# (Vercel auto-treats root server.py/main.py/app.py as a Python entrypoint;
#  localdev.py avoids that name, and this also keeps it out of the build entirely.)
localdev.py

# Python serverless functions — temporarily excluded so Vercel deploys as a clean
# STATIC site. Vercel's newer Python builder tries to treat /api as a single app
# (one entrypoint) and fails on our 3 separate handler files. The app needs none of
# these to run: login/cloud-sync are client-side (Supabase), and the AI endpoints
# require ANTHROPIC_API_KEY (not set) and already fall back to an offline parser.
# Re-enable with a single consolidated entrypoint when wiring up live Claude AI.
api/

# Local dev / archive cruft
_archive_nextjs/
__pycache__/
*.pyc
.env
